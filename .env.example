# Flask Secret Key for session signing
SECRET_KEY=replace-with-a-random-secret-key

# PostgreSQL Connection String (e.g. from Render, Neon, Supabase, or local)
# If left unset, the app will automatically fall back to local SQLite (task_manager.db)
DATABASE_URL=postgresql://postgres:password@localhost:5432/task_manager_db

# Optional Port (cloud providers set this automatically)
PORT=5000
